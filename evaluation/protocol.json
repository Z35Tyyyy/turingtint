{
  "version": 1,
  "allowed_scripts": ["evaluation/check_software.py", "evaluation/check_corpus.py", "evaluation/check_browser.py"],
  "implementation_paths": ["turingtint", "web", "corpus_tools", "iteration", "tests", "requirements.txt", "requirements-dev.txt"],
  "input_paths": ["data/reference.sqlite", "data/corpus-seed/manifest.json"],
  "checks": [
    {"id": "software-tests", "script": "evaluation/check_software.py", "args": [], "required": true, "timeout_seconds": 90, "output": "json"},
    {"id": "reference-corpus", "script": "evaluation/check_corpus.py", "args": [], "required": true, "timeout_seconds": 15, "output": "json"},
    {"id": "browser-integration", "script": "evaluation/check_browser.py", "args": [], "required": true, "timeout_seconds": 90, "output": "json"}
  ],
  "gates": [
    {"id": "working-prototype", "description": "Software, browser checks and corpus ingestion pass; this does not establish detection accuracy.", "check_ids": ["software-tests", "reference-corpus", "browser-integration"], "required": true},
    {"id": "authorship-validation", "description": "A licensed local detector needs independent calibration and paragraph-level false-positive, recall and coverage evidence before authorship claims are enabled.", "check_ids": [], "required": true},
    {"id": "mixed-span-validation", "description": "Mixed authorship and sentence highlights need distinct ground truth and localization evaluation.", "check_ids": [], "required": true},
    {"id": "retrieval-benchmark", "description": "A held-out source-matching benchmark must measure exact/near-exact precision, recall, common-phrase false alarms and source-absent cases.", "check_ids": [], "required": true}
  ],
  "review_slots": [{"id": "independent-review", "required": true}]
}
